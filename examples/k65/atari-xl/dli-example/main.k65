var VDSLST = 0x0200
var SDLST  = 0x0230

var screen = 0x8000

data displist {
  nocross
  0x70 0x70 0x70
  0x42 &<screen &>screen
  2 2 2
  0xF0
  2 2 2 2
  0x41 &<displist &>displist
}

// The hardware enters this handler, not a `call`, so nothing K816 can see
// establishes the register widths it runs at — the interrupted code's widths
// are whatever that code last set. This program never widens, so the handler
// says so: the annotation is the invariant the program keeps, and without it
// the immediate below cannot be sized.
naked dli @a8 @i8 {
  a!!
  COLPF2=a=0xDE WSYNC=a
  a??
  return_i
}

main {
  SDLST=a=&<displist SDLST+1=a=&>displist
  VDSLST=a=&<dli VDSLST+1=a=&>dli
  NMIEN=a=0xC0
  {} always
}
