// The definitions this program shares with the others in this directory.
// Each is its own program: one entry, and the units it names.
import "../include/defs.k65"

var PCOLR0 = 0x02C0

data stars {
  align 256
  for x=0..255 eval [ rnd() & 255 ]
}

data speed {
  align 256
  for x=0..255 eval [ (rnd() & 3) + 1 ]
}

main {
  PCOLR0=a=14 GRAFM=a
  {
    a=0 { a?VCOUNT } !=
    x=0 {
      WSYNC=a
      HPOSM0=a=stars,x
      a=stars,x a+speed,x stars,x=a
      x++
    } !=
  } always
}