; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section aligned
aligned
;  // what does `align N + M` place?
;  //
;  // `Align` sits between `SecStart` and the body of `func`, `naked`, `main` and
;  // `data` in the original grammar (compiler.inc:121-136), which the modern
;  // documents never say.  `align N + M` is a boundary *and* an offset, and the
;  // golden's addresses are what decides whether that means "the section starts
;  // at a multiple of N plus M" or something else.
;  //
;  // K816 reads `align 256 + 8` as `align 264` today, which is why this fixture
;  // exists (plans/06-compatibility.md decision 15).
;  
;  func aligned {
;    align 256 + 8
;    a = 1
    LDA     #$01
;  }
;  
    RTS
; section addressed
addressed
;    address 0x2040
;    a = 2
    LDA     #$02
;  }
;  
    RTS
; section offset_table
offset_table
;    align 16 + 4
;    1 2 3
    .byte     #$01
    .byte     #$02
;  }
    .byte     #$03
;  
; section main
main
    JSR     aligned
;    call aligned
;    call addressed
    JSR     addressed
;    a = offset_table
    LDA     offset_table
;    return
;  }
    RTS
;  
; section __start
    JMP		main
