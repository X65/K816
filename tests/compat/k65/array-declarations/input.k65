// Oracle question: what does the bracket in `var X[N]` allocate, and in what
// units?
//
// `Var -> Ident BracketNumber Verbose` and `Var -> Ident BracketNumber =
// Number Verbose` (compiler.inc:38-39) pass `num($2)` to the compiler's
// `var(name, address, isconst, count, verbose)` as its *count*
// (compiler_src.cpp), and no document of either compiler says what a count
// counts.  The golden answers it by where the variables after the bracket
// land: `lead` is pinned at $80, so every allocated name after it is placed
// consecutively, and the gap the bracket leaves is the size of N units.
//
// It also asks whether an addressed bracket declaration takes the allocator
// with it - `placed[3] = 0x90` names its own address, and where
// `after_placed` lands says whether the allocator followed.
//
// And the third question is what the bracket *holds*.  `BracketNumber ->
// [ EvalCode ]` (compiler.inc:330) is the evaluator, not a numeric terminal,
// so a name should reach it: `sized[SIZE]` is here to prove that it does,
// and that the count it yields is the same one a literal would.

const SIZE = 4

var lead = 0x80
var span[4]
var trail
var sized[SIZE]
var after_sized
var placed[3] = 0x90
var after_placed

main {
  x = 0
  a = lead
  a = span,x
  span,x = a
  a = trail
  a = sized,x
  a = after_sized
  a = placed,x
  a = after_placed
  return
}
