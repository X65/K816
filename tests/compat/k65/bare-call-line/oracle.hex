# Oracle golden - the bytes the original K65 compiler produced.
#
# This file is generated by tests/compat/oracle.sh and is committed so
# that the suite does not depend on a compiler outside the tree
# (plans/06-compatibility.md decision 2).  `cargo test` never runs the
# original; it re-checks the revision and the checksums below, so a
# source edited without re-running the script fails.
#
# fixture   bare-call-line
# compiler  version 0.2.1, build Feb  9 2026 02:31:38
# revision  920a4e40e853c4cb563302f3c88d81ba4687c4ed
# command   cd $K65_HOME/workdir && ../out/k65.exe @<this-directory>/bare-call-line.k65proj
# input     input.k65        adler32 E9F2360F  1682 bytes
# input     oracle.conf      adler32 BDCD1422  66 bytes
# project
#     -system AtariXL
#     -lowAddr 0x2000
#
#     input.k65   main
#
#     -o ./bare-call-line.bin
#
#     -link
#
# The Atari executable framing - $FFFF, the start and end words, and the
# trailing RUNAD segment at $02E0 - belongs to the Atari loader and is
# stripped.  What follows is the program image alone.
#
# Sixteen bytes per line, load address in the left column.

origin 2000
2000  4C 04 20 5A A5 80 85 81 85 80 85 81 85 82 85 81
2010  AD 03 20 60
