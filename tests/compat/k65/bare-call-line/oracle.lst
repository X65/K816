; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section answers
answers
    .byte     #$5A
;  
; section main
main
    LDA     slot
;    a = slot
;    stamp_one slot = a
	; inlined stamp_one
__I1stamp_one
    STA     one
	; end of inlined stamp_one
    STA     slot
;    stamp_one
;    stamp_two stamp_one
	; inlined stamp_one
__I2stamp_one
    STA     one
	; end of inlined stamp_one
	; inlined stamp_two
__I3stamp_two
    STA     two
	; end of inlined stamp_two
;    a = answers
	; inlined stamp_one
__I4stamp_one
    STA     one
	; end of inlined stamp_one
    LDA     answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
