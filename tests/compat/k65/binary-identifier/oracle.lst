; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section blob
blob
    .byte   #$AA
    .byte   #$BB
    .byte   #$CC
;  // identifier name?
;  //
;  // The question is worth asking because the rule directly above it in the
;  // grammar looks the same and behaves differently: `ImgLoad -> image Ident`
;  // calls `img.Load(($2 + ".bmp").c_str())` (compiler.inc:64) and *appends* an
;  // extension, while `BinLoad -> binary Ident` calls `loadbinary(($2).c_str())`
;  // (compiler.inc:71) and does not.  So `binary table` opens a file named
;  // exactly `table`, with no extension, and the fixture's data file is named
;  // that way on purpose.
;  
;  data blob {
;    binary table
;  }
;  
; section answers
answers
    .byte     #$03
;    [ size(blob) ]
;    [ index(blob, 1) ]
    .byte     #$BB
;  }
;  
; section main
main
    LDA     blob
;    a = blob
;    a = answers
    LDA     answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
