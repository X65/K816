; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section blob
blob
    .byte   #$0A
    .byte   #$0B
    .byte   #$0C
    .byte   #$0D
    .byte   #$0E
;  // read it back?
;  //
;  // `BinLoad` calls `loadbinary` and `pullbinary` (compiler.inc:70-72), which
;  // pushes each byte through `datavalue` - so the bytes are section bytes like
;  // any others, `index` and `size` see them, and the section's transform gets
;  // them too (`evaluator-transform` measures that half).
;  //
;  // Where the *file* is looked for was measured rather than assumed: the
;  // original opens the name as written, against the process's working
;  // directory.  K816 resolves it against the directory of the source that wrote
;  // the line and emits `.incbin` with the name untouched, which is the
;  // `backend-different` half of decision 8.
;  
;  data blob {
;    binary "table.bin"
;  }
;  
; section around
around
    .byte     #$FF
;    0xFF
;    binary "table.bin"
    .byte   #$0A
    .byte   #$0B
    .byte   #$0C
    .byte   #$0D
    .byte   #$0E
;    0xFE
;  }
    .byte     #$FE
;  
; section answers
answers
    .byte     #$05
;    [ size(blob) ]
;    [ index(blob, 3) ]
    .byte     #$0D
;    [ size(around) ]
    .byte     #$07
;  }
;  
; section main
main
    LDA     blob
;    a = blob
;    a = around
    LDA     around
;    a = answers
    LDA     answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
