; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section plain
plain
    .byte     #$01
;  // `code { }` subblock, and a string.  All three are `compatible` and none had
;  // a golden of its own.
;  //
;  // The string is here with a `charset` and under a section transform, because
;  // that is the one interaction the three have: a character is a *generated*
;  // byte, so the transform reaches it, and the `repeat` around it has to carry
;  // the mapping into every copy.
;  //
;  // The subblock is `c+` - SEC - rather than a load, because a data section has
;  // no register-width context and an immediate there would need one.
;  
;  data plain {
;    repeat 3 { 1 2 }
    .byte     #$02
;    code { c+ }
    .byte     #$01
;  // `code { }` subblock, and a string.  All three are `compatible` and none had
;  // a golden of its own.
;  //
;  // The string is here with a `charset` and under a section transform, because
;  // that is the one interaction the three have: a character is a *generated*
;  // byte, so the transform reaches it, and the `repeat` around it has to carry
;  // the mapping into every copy.
;  //
;  // The subblock is `c+` - SEC - rather than a load, because a data section has
;  // no register-width context and an immediate there would need one.
;  
;  data plain {
;    repeat 3 { 1 2 }
    .byte     #$02
;    code { c+ }
    .byte     #$01
;  // `code { }` subblock, and a string.  All three are `compatible` and none had
;  // a golden of its own.
;  //
;  // The string is here with a `charset` and under a section transform, because
;  // that is the one interaction the three have: a character is a *generated*
;  // byte, so the transform reaches it, and the `repeat` around it has to carry
;  // the mapping into every copy.
;  //
;  // The subblock is `c+` - SEC - rather than a load, because a data section has
;  // no register-width context and an immediate there would need one.
;  
;  data plain {
;    repeat 3 { 1 2 }
    .byte     #$02
;    code { c+ }
    SEc
;    charset " ABC"
;    "CAB"
;  }
    .byte   #$03
    .byte   #$01
    .byte   #$02
;  
; section mapped
mapped
;    charset " ABC"
;    evaluator [ x + 0x40 ]
;    repeat 2 { "AB" }
    .byte   #$41
    .byte   #$42
;    "C"
    .byte   #$41
    .byte   #$42
;    "C"
;  }
    .byte   #$43
;  
; section main
main
    LDA     plain
;    a = plain
;    a = mapped
    LDA     mapped
;    return
;  }
    RTS
;  
; section __start
    JMP		main
