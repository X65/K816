; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section spellings
spellings
    .byte     #$1E
;    [ index(source, 2) ]      // the function
;    [ source[1] ]             // the operator
    .byte     #$14
;    [ source.index(3) ]       // the method call, one argument
    .byte     #$28
;    [ source.size ]           // the method call, no arguments
    .byte     #$04
;  }
;  
; section filtered_literals
filtered_literals
;    evaluator [ x * 2 + 1 ]
;    1 2 3
    .byte     #$01
    .byte     #$02
;  }
    .byte     #$03
;  
; section filtered_generated
filtered_generated
;    evaluator [ x * 2 + 1 ]
;    for i = 0 .. 3 eval [ i ]
    .byte   #$01
    .byte   #$03
    .byte   #$05
    .byte   #$07
;  }
;  
; section filtered_string
filtered_string
;    charset " ABC"
;    evaluator [ x + 0x40 ]
;    "CAB"
;  }
    .byte   #$43
    .byte   #$41
    .byte   #$42
;  
; section string_values
string_values
    .byte     #$01
;    [ "ab" == "ab" ]
;    [ "ab" == "ba" ]
    .byte     #$00
;    [ "a" < "b" ]
    .byte     #$01
;  }
;  
; section main
main
    LDA     spellings
;    a = spellings
;    a = filtered_literals
    LDA     filtered_literals
;    a = filtered_generated
    LDA     filtered_generated
;    a = filtered_string
    LDA     filtered_string
;    a = string_values
    LDA     string_values
;    return
;  }
    RTS
;  
; section __start
    JMP		main
