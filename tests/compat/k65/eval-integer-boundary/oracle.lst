; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section boundary
boundary
    .byte     #$FF
;  // truncate, and is a value outside the context's range wrapped or refused?
;  //
;  // plans/06-compatibility.md decision 4 says the answer is measured here and
;  // recorded in the manifest rather than guessed.  Every entry below is one
;  // byte, so the whole numeric model reads off the golden:
;  //
;  //   .5 up or to even, negatives, and what happens past $FF.
;  
;  data boundary {
;    [ 255 ]           // in range
;    [ 300 ]           // past $FF
    .byte     #$12C
;    [ 65536 ]         // past $FFFF
    .byte     #$10000
;    [ 0 - 1 ]         // negative
    .byte     #$FFFFFFFF
;    [ 2.4 ] [ 2.5 ] [ 2.6 ]
    .byte     #$02
    .byte     #$03
    .byte     #$03
;    [ 0 - 2.4 ] [ 0 - 2.5 ] [ 0 - 2.6 ]
    .byte     #$FFFFFFFE
    .byte     #$FFFFFFFE
    .byte     #$FFFFFFFD
;    [ 0.5 ] [ 1.5 ] [ 2.5 ] [ 3.5 ]     // .5 four times: up, or to even?
    .byte     #$01
    .byte     #$02
    .byte     #$03
    .byte     #$04
;    [ 7 / 2 ]                            // 3.5 arrived at by division
    .byte     #$04
;    [ 16777217 - 16777216 ]              // 2^24+1 and 2^24 as two literals
    .byte     #$00
;    [ 16777216 + 1 - 16777216 ]          // the same sum inside one expression
    .byte     #$01
;    [ ( 0.1 + 0.2 - 0.3 ) * 1000000000 ] // is the arithmetic single or double?
    .byte     #$FFFFFFF9
;  
;    // And what the conversion converts *to*. `doeval` narrows through a C++
;    // `int` (`compiler_src.cpp:392`), so the interesting boundary is $7FFFFFFF
;    // rather than anything 64-bit, and past it the conversion is undefined
;    // behaviour rather than a wrap. All four of these are out of range: the
;    // first because `f32(2147483647)` is 2147483648.0, which `int` cannot hold.
;    [ 2147483647 ] [ 2147483648 ] [ 3000000000 ] [ 0 - 2147483649 ]
    .byte     #$80000000
    .byte     #$80000000
    .byte     #$80000000
    .byte     #$80000000
;  }
;  
; section main
main
    LDA     boundary
;    a = boundary
;    return
;  }
    RTS
;  
; section __start
    JMP		main
