; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section library
library
    .byte     #$0E
;  // computed by hand.
;  //
;  // `pi` is the literal `3.141593` and not the machine constant
;  // (`compiler.inc:438`), which the first two entries pin: a table generated
;  // with a different constant is a table with different bytes.
;  //
;  // `abs` is **not** in the original's library - it ends the build there
;  // (`k65/eval-refusals`) - and is here because decision 5 lists it.  It is a
;  // `K816-extension` row, and `--strict-k65` has to reject it.
;  
;  data library {
;    [ pi * 100 - 300 ]            // 14   - 3.141593, six decimals
;    [ pi * 1000000 - 3141500 ]    // 93   - and not 3.14159265...
    .byte     #$5D
;    [ sin(0) ]                    // 0
    .byte     #$00
;    [ cos(0) ]                    // 1
    .byte     #$01
;    [ asin(1) * 100 - 150 ]       // 7    - pi/2 is 1.5707963
    .byte     #$07
;    [ acos(1) ]                   // 0
    .byte     #$00
;    [ sqrt(144) ]                 // 12
    .byte     #$0C
;    [ pow(2, 5) ]                 // 32
    .byte     #$20
;    [ floor(2.7) ]                // 2
    .byte     #$02
;    [ ceil(2.1) ]                 // 3
    .byte     #$03
;    [ round(2.5) ]                // 3    - half up, like every boundary
    .byte     #$03
;    [ frac(2.75) * 100 ]          // 75
    .byte     #$4B
;    [ min(3, 5) ]                 // 3
    .byte     #$03
;    [ max(3, 5) ]                 // 5
    .byte     #$05
;    [ clamp(9, 1, 5) ]            // 5
    .byte     #$05
;    [ clamp(0, 1, 5) ]            // 1
    .byte     #$01
;  }
;  
; section sugar
sugar
    .byte     #$05
;    [ (3).max(5) ]                // 5    - `x.f(a)` is `f(x, a)`
;    [ (2.75).frac() * 100 ]       // 75   - and `x.f()` is `f(x)`
    .byte     #$4B
;  }
;  
; section main
main
    LDA     library
;    a = library
;    a = sugar
    LDA     sugar
;    return
;  }
    RTS
;  
; section __start
    JMP		main
