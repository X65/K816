; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section ops
ops
    .byte     #$07
;  // table actually compute?
;  //
;  // The table is a list of spellings and precedences and says almost nothing
;  // about semantics, so every entry below carries a value worked out by hand
;  // and the golden is the arbiter.  Three of them were wrong in a document or
;  // in the plan before this fixture:
;  //
;  //   - `%` is a *non-negative* modulo, `fmod(fmod(a,b)+b,b)`, so `(0-7) % 3`
;  //     is 2 and not -1.
;  //   - a bitwise operand is converted by `EvalAny::ToInt`, which is not the
;  //     integer boundary rule: it truncates toward zero.
;  //   - `&&` does not short-circuit; the stack machine pops two values that
;  //     were both computed.
;  //
;  // Two spellings are deliberately absent because the original does not have
;  // them, and they are in `tests/compat/k816/eval-extensions/` instead: `||`,
;  // which is not a token there, and the prefix `++`/`--`, whose grammar action
;  // reads `$1` where it means `$2` and which therefore abort the compiler.
;  
;  data ops {
;    [ 1 + 2 * 3 ]                 // 7   - precedence
;    [ (1 + 2) * 3 ]               // 9
    .byte     #$09
;    [ 7 - 2 ]                     // 5
    .byte     #$05
;    [ 7 / 2 ]                     // 4   - float division, then rounded
    .byte     #$04
;    [ 7 % 3 ]                     // 1
    .byte     #$01
;    [ (0 - 7) % 3 & 255 ]         // 2   - non-negative modulo
    .byte     #$02
;    [ 1 << 4 ]                    // 16
    .byte     #$10
;    [ 64 >> 2 ]                   // 16
    .byte     #$10
;    [ 12 & 10 ]                   // 8
    .byte     #$08
;    [ 12 | 3 ]                    // 15
    .byte     #$0F
;    [ 12 ^ 10 ]                   // 6
    .byte     #$06
;    [ ~5 & 255 ]                  // 250
    .byte     #$FB
;    [ (0 - 2.7) & 255 ]           // 254 - truncation toward zero
    .byte     #$FE
;    [ !0 ]                        // 1
    .byte     #$01
;    [ !3 ]                        // 0
    .byte     #$00
;    [ 3 < 5 ]                     // 1
    .byte     #$01
;    [ 3 <= 3 ]                    // 1
    .byte     #$01
;    [ 3 > 5 ]                     // 0
    .byte     #$00
;    [ 3 >= 5 ]                    // 0
    .byte     #$00
;    [ 3 == 3 ]                    // 1
    .byte     #$01
;    [ 3 != 3 ]                    // 0
    .byte     #$00
;    [ 3 ?> 5 ]                    // 5   - the greater
    .byte     #$05
;    [ 3 ?< 5 ]                    // 3   - the smaller
    .byte     #$03
;    [ 2 && 5 ]                    // 1
    .byte     #$01
;    [ 3 && 0 ]                    // 0
    .byte     #$00
;    [ 5 ? 11 : 22 ]               // 11
    .byte     #$0B
;    [ 0 ? 11 : 22 ]               // 22
    .byte     #$16
;    [ 1, 2, 3 ]                   // 3   - the list's value is its last item
    .byte     #$03
;  }
;  
; section assignments
assignments
    .byte     #$07
;    [
;      QQ = 4,                     // an assignment's value is what it set
;      QQ += 3, QQ                 // 7
;    ]
;  }
;  
; section compounds
compounds
    .byte     #$02
;    [
;      RR = 7,
;      RR -= 2, RR,                // 5
;      RR *= 3, RR,                // 15
;      RR /= 5, RR,                // 3
;      RR %= 2, RR,                // 1
;      RR <<= 4, RR,               // 16
;      RR >>= 2, RR,               // 4
;      RR &= 6, RR,                // 4
;      RR |= 3, RR,                // 7
;      RR ^= 5, RR                 // 2
;    ]
;  }
;  
; section steps
steps
    .byte     #$03
;    [
;      SS = 2,
;      SS++,                       // the old value, and SS is 3
;      SS++,                       // 3, and SS is 4
;      SS--,                       // 4, and SS is 3
;      SS                          // 3
;    ]
;  }
;  
; section main
main
    LDA     ops
;    a = ops
;    a = assignments
    LDA     assignments
;    a = compounds
    LDA     compounds
;    a = steps
    LDA     steps
;    return
;  }
    RTS
;  
; section __start
    JMP		main
