; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section answers
answers
    .byte     #$30
;    [ FLAG_A ]                // a const alone
;    [ FLAG_A | FLAG_B ]       // two consts folded
    .byte     #$3C
;    [ index(tab, 2) ]         // a data label read as a section
    .byte     #$1E
;  }
;  
; section main
main
    LDA     answers
;    a = answers
;    a = [ FLAG_B ]            // and a bracket in operand position
    LDA     #$0C
;    return
;  }
    RTS
;  
; section __start
    JMP		main
