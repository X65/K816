; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section filtered
filtered
    .byte   #$01
    .byte   #$02
;  // ask.  That fixture measured *which* entries `evaluator [ code ]` reaches;
;  // this one measures the rest of the rule.
;  //
;  //   - it is positional: the entries written above it are already emitted,
;  //     and a second `evaluator` replaces the first rather than composing with
;  //     it (compiler_src.cpp installs one program per section);
;  //   - the answer is masked to eight bits by truncation - `int(v) & 0xFF` -
;  //     where every other integer boundary in the evaluator rounds;
;  //   - every byte of a `binary` goes through it, which is what forces K816 to
;  //     read the file instead of leaving the inclusion to the assembler;
;  //   - `index` and `size` read the section *after* the transform;
;  //   - and a transform whose body *assigns* is the one shape `--strict-k65`
;  //     warns about, which is why `assigning` is here: the bytes agree and the
;  //     assignment does not escape.  What the assignment does *afterwards* is
;  //     the row's one divergence and it cannot be committed as a source, for
;  //     two reasons that both belong to K816 - see the note below.
;  
;  data filtered {
;    for i = 1 .. 2 eval [ i ]     // above the transform: untouched
;    evaluator [ x * 100 ]
;    for i = 1 .. 3 eval [ i ]     // 100, 200, and 300 masked to 0x2C
    .byte   #$64
    .byte   #$C8
    .byte   #$2C
;    evaluator [ x + 1 ]           // replaces the first, does not compose
;    for i = 1 .. 2 eval [ i ]
    .byte   #$02
    .byte   #$03
;    evaluator [ 0 - x ]           // a negative answer masks the same way
;    for i = 1 .. 2 eval [ i ]
    .byte   #$FF
    .byte   #$FE
;    evaluator [ x + 0.6 ]         // and a fractional one truncates
;    for i = 1 .. 2 eval [ i ]
    .byte   #$01
    .byte   #$02
;  }
;  
; section included
included
;    evaluator [ x + 0x10 ]
;    binary "table.bin"
    .byte   #$11
    .byte   #$12
    .byte   #$13
    .byte   #$14
;  }
;  
; section assigning
assigning
;    evaluator [ T = x, T ]        // a transform that assigns: every byte is
;    for i = 7 .. 7 eval [ i ]     // itself, and `T` is written once per byte
    .byte   #$07
;  }
;  
; section answers
answers
    .byte     #$64
;    [ index(filtered, 2) ]        // the transformed byte, not the raw one
;    [ size(filtered) ]
    .byte     #$0B
;    [ index(included, 0) ]
    .byte     #$11
;  }
;  
; section main
main
    LDA     filtered
;    a = filtered
;    a = included
    LDA     included
;    a = assigning
    LDA     assigning
;    a = answers
    LDA     answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
