; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section helper
helper
    LDA     #$01
;  // that expands the same body.  Part one: the section and the inline.
;  //
;  // `doc/k65/known-bugs.md`: "Far calls placed in inline blocks do not work
;  // correctly if the inline is used in different bank that it was defined."
;  // `oracle.lst` is what that sentence looks like.
;  
;  func helper {
;    a = 1
;    return
;  }
    RTS
;  
    RTS
; section __far_core_core__helper
__far_core_core__helper
    BIT     __banksel_core
    JSR     helper
    BIT     __banksel_core
    RTS
; section second
second
	; inlined hop
__I1hop
    JSR     __far_core_core__helper
	; end of inlined hop
;  // bank `extra`, and it expands the same `hop`.
;  
;  func second {
;    hop
;    return
;  }
    RTS
;  
    RTS
; section main
main
	; inlined hop
__I2hop
    JSR     __far_core_core__helper
	; end of inlined hop
;  // the one to `second` is the control: a far call written *outside* an inline
;  // gets a trampoline named for the bank it is written in, which is right.
;  //
;  // Every reference points backwards.  A far call to a section the original has
;  // not read yet aborts it without a diagnostic, inline or not, which is a
;  // separate defect and not this fixture's.
;  
;  main {
;    hop
;    far second
    JSR     __far_core_extra__second
;  }
;  
; section __far_core_extra__second
__far_core_extra__second
    BIT     __banksel_extra
    JSR     second
    BIT     __banksel_core
    RTS
; section __vectors
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
; section __entry
__entry
    BIT     __banksel_core
    JMP     main
