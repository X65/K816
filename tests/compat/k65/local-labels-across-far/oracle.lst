; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section main
main
__local0_top
;  //
;  // `doc/k65/known-bugs.md`: "Local labels can't be accessed across certain
;  // language constructs (like far calls).  Local labels before and after such
;  // construct appear to be in different local namespaces."
;  //
;  // Both directions are here.  `.rest` is named before it is defined and the
;  // far jump is what stands between them; `.top` is named after the far jump
;  // and defined before it.  A split namespace would make one of the two
;  // unresolvable.
;  //
;  // Nothing here has an immediate, so the source needs no width annotation and
;  // stays K65 rather than K816.
;  
;  main {
;  .top:
;    x--
    DEX
;    far goto .rest
    JMP     __farjmp_core___local0_rest
;  .rest:
__local0_rest
;    z-? goto .top
    BNE     __local0_top
;  }
;  
; section __vectors
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
; section __entry
__entry
    BIT     __banksel_core
    JMP     main
; section __farjmp_core___local0_rest
__farjmp_core___local0_rest
    BIT     __banksel_core
    JMP     __local0_rest
