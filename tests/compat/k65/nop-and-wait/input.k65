// Oracle question: what do `*`, `* N` and `%` actually emit?
//
// doc/syntax-reference.md says `* 5` is "5 NOPs" and `%` is `BRK`; the
// original's `opnop` counts *cycles* and spends an odd one through a
// three-cycle `NOP $80` (compiler.inc:151-153, compiler_src.cpp:540).  The
// golden settles it, and it is the evidence behind decision 11 - the one
// place K816 keeps its own meaning for a K65 spelling.
//
// `o-` rides along because `Flag -> o` is the original's spelling of the
// overflow flag and ours is `v` (decision 14).
//
// The rest of the flag and stack forms ride along for a duller reason: this
// is the fixture the `flag-tokens`, `instr-flag-set`, `instr-stack-flags` and
// `instr-return` rows answer to, and a row whose fixture does not contain its
// construct is how `binary Ident` and `far goto` both shipped.  `o+` is
// deliberately absent - the 65816 has no `SEV`, the original assembles `SEv`
// and dies without a diagnostic, and `instr-flag-set` records that.

main {
  *
  * 5
  * 6
  %
  o-
  c+ c-
  d+ d-
  i+ i-
  a ??
  a !!
  z??
  z!!
  c??
  c!!
  return
}

// `return_i` is `RTI`, and a section that returns through it is entered by the
// hardware rather than by a call - so it is `naked`, which is also the only
// section kind with no return of its own to collide with it.
naked handler {
  a ??
  return_i
}
