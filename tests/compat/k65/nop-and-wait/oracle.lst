; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section main
main
    NOP
;  //
;  // doc/syntax-reference.md says `* 5` is "5 NOPs" and `%` is `BRK`; the
;  // original's `opnop` counts *cycles* and spends an odd one through a
;  // three-cycle `NOP $80` (compiler.inc:151-153, compiler_src.cpp:540).  The
;  // golden settles it, and it is the evidence behind decision 11 - the one
;  // place K816 keeps its own meaning for a K65 spelling.
;  //
;  // `o-` rides along because `Flag -> o` is the original's spelling of the
;  // overflow flag and ours is `v` (decision 14).
;  
;  main {
;    *
;    * 5
    NOP     $80
    NOP
;    * 6
    NOP
    NOP
    NOP
;    %
;    o-
    NOP     $80
    CLv
;    a ??
    PLA
;    a !!
    PHA
;    z??
;    z!!
    PLP
;    return
    PHP
;  }
    RTS
;  
; section __start
    JMP		main
