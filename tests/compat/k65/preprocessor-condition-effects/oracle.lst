; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section tab
tab
    .byte     #$01
;  // relative to each other, and what does a condition leave behind?
;  //
;  // Both are questions about *order*.  The original compiles in one pass, so a
;  // bracket and a directive run as the parser reduces them and the answer can
;  // only be "in source order"; K816 has passes, and a pass that decides every
;  // directive in an item before running the item's brackets gets the first one
;  // wrong.  The bytes say which happened.
;  //
;  // `PPIfNumber -> [ EvalCode ]` goes through the same `doeval` as any other
;  // bracket (`compiler.inc:23,328`), against the same global variable table, so
;  // a condition that assigns should leave the name behind for the code below.
;  
;  data tab {
;    [ FLAG = 1 ]      // emits 1, and assigns FLAG
;    #if FLAG          // ... which this reads, three lines further down
;    0x42
;    #else
    .byte     #$42
;    0x24
;    #endif
;  }
;  
; section main
main
    LDA     tab
;    a = tab
;    a = [ MODE ]      // MODE survives the directive that assigned it
    LDA     #$03
;    return
;  }
    RTS
;  
; section __start
    JMP		main
