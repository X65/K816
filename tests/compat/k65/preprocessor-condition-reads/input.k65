// Oracle question: what namespace does a `#if` condition read, and how does a
// non-integer value decide?
//
// `PPIfNumber -> AllIdent` evaluates the name as `"@?"+$1` through `doeval`
// (`compiler.inc:24`) - the same reader an evaluator bracket uses - so the
// answer decides whether K816's preprocessor may run before the symbol table
// exists.  Four readings are asked at once, each writing a different byte so
// the golden says which branch ran.
//
// `doeval` returns `int(floor(x+.5f))` and `pp_if` tests `num($2)!=0`
// (`compiler_src.cpp:387`, `compiler.inc:15`), so a bracket condition is
// already through the integer boundary rule before it decides anything: 0.6
// is one and 0.4 is zero.

// The bracket comes first because K816 cannot parse it after a `const`:
// `const FEATURE = 1` followed by a line starting with `[` reads the block as
// a *subscript* of the initializer, K65 being newline-insensitive.  That is a
// K816 defect of its own, not a fact about the preprocessor, and the manifest
// row `newline-subscript` carries it.
[ DEBUG = 1 ]
const FEATURE = 1

data answers {

  #if FEATURE               // a compiler `const`
  0x11
  #else
  0x22
  #endif

  #if DEBUG                 // a name an evaluator bracket assigned
  0x33
  #else
  0x44
  #endif

  #if [0.6]                 // rounds up, so the region is taken
  0x55
  #else
  0x66
  #endif

  #if [0.4]                 // rounds down, so it is not
  0x77
  #else
  0x88
  #endif

  #if 0                     // the `#elif` chain: the second branch wins
  0x99
  #elif 1
  0xAA
  #elif 1
  0xBB
  #else
  0xCC
  #endif
}

main {
  a = answers
  return
}
