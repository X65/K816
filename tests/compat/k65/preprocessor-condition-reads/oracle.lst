; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section answers
answers
;  
;    #if FEATURE               // a compiler `const`
;    0x11
;    #else
    .byte     #$11
;    0x22
;    #endif
;  
;    #if DEBUG                 // a name an evaluator bracket assigned
;    0x33
;    #else
    .byte     #$33
;    0x44
;    #endif
;  
;    #if [0.6]                 // rounds up, so the region is taken
;    0x55
;    #else
    .byte     #$55
;    0x66
;    #endif
;  
;    #if [0.4]                 // rounds down, so it is not
;    0x77
;    #else
;    0x88
;    #endif
    .byte     #$88
;  
;    #if 0                     // the `#elif` chain: the second branch wins
;    0x99
;    #elif 1
;    0xAA
;    #elif 1
    .byte     #$AA
;    0xBB
;    #else
;    0xCC
;    #endif
;  }
;  
; section main
main
    LDA     answers
;    a = answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
