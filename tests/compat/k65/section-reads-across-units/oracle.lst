; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section answers
answers
    .byte     #$14
;  //
;  // `index` and `size` take a section, and a section is a compiler-global
;  // object in the original - `state.GetSection(value_i)` reaches every section
;  // the project has compiled so far, not just this unit's.  If that is right, a
;  // read here answers from `defs.k65`'s bytes.
;  
;  data answers {
;    [ index(shared, 1) ]
;    [ size(shared) ]
    .byte     #$03
;  }
;  
; section main
main
    LDA     answers
;    a = answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
