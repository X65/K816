; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section answers
answers
    .byte     #$16
;    [ index(t, 1.7) ]         // ToInt, not the boundary rule: t[1]
;    [ index(t, 2.9) ]         // still floor: t[2]
    .byte     #$21
;    [ index(t, 5) ]           // out of range, and no diagnostic
    .byte     #$00
;    [ index(t, 0 - 1) ]       // ToInt lands one too high, so t[0]
    .byte     #$0B
;    [ size(gaps) ]            // `?` is a byte of the raw table
    .byte     #$03
;    [ index(gaps, 1) ]        // and the byte is zero
    .byte     #$00
;  }
;  
; section main
main
    LDA     answers
;    a = answers
;    return
;  }
    RTS
;  
; section __start
    JMP		main
