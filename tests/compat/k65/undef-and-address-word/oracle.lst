; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section target
target
    .byte     #$77
;  // and `&&label`, an address as two bytes.
;  //
;  //   - `Data -> ?` is `opsimp(".undef")` (compiler.inc:74).  The original
;  //     leaves the byte to its linker, which fills zero; K816 emits an explicit
;  //     `.res 1`, and the image agrees.
;  //   - `Data -> && VarArg` is `oparith(".byte", argto(AM_OFS_LO, $2))` then
;  //     `AM_OFS_HI` (compiler.inc:63) - low byte first.  K816 lowers it to
;  //     `.word .loword(sym)`, which is the same two bytes in the same order.
;  
;  data target { 0x77 }
;  
; section shape
shape
    .byte     #$01
;    1
;    ?
;    2
    .undef
;    &&target
    .byte     #$02
    .byte     #<(target)
    .byte     #>(target)
;    3
;  }
    .byte     #$03
;  
; section main
main
    LDA     shape
;    a = shape
;    return
;  }
    RTS
;  
; section __start
    JMP		main
