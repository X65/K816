; Oracle listing - the original K65 compiler's own .lst for this
; fixture, kept for the rows compared at the instruction sequence
; rather than at the bytes.  Generated by tests/compat/oracle.sh;
; oracle.hex beside it carries the provenance for both.
;
; section glyphs
glyphs
;    align 256
;    image sheet 0 0 8 > 8 v
    .byte   #$FF
    .byte   #$7F
    .byte   #$BF
    .byte   #$3F
    .byte   #$DF
    .byte   #$5F
    .byte   #$9F
    .byte   #$1F
;    tiles 8 8 3
    .byte   #$6F
    .byte   #$AF
    .byte   #$2F
    .byte   #$CF
    .byte   #$4F
    .byte   #$8F
    .byte   #$0F
    .byte   #$F7
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
    .byte   #$00
;  }
;  
; section main
main
    SEi
;    i+ d-
    CLd
;    s = x = 0xFF
    LDX     #$FF
    TXS
;    a = 0
    LDA     #$00
;    { CXCLR,x = a  x-- }!=
__label_1
    STA     CXCLR,X
    DEX
    BNE     __label_1
;  
;    {                                 // the frame loop
__label_2
;      blank
;      a = [ TILE_ROWS ]               // a bracket in operand position
	; inlined blank
__I1blank
    LDA     #$02
    STA     VBLANK
	; end of inlined blank
    LDA     #$08
;      cursor = a
    STA     cursor
;      x = 0
    LDX     #$00
;  
;      {                               // the scanline loop
__label_3
;        wsync HMOVE = a               // a bare call and a store, on one line
	; inlined wsync
__I2wsync
    STA     WSYNC
	; end of inlined wsync
    STA     HMOVE
;        a = glyphs,x
    LDA     glyphs,X
;        GRP0 = a
    STA     GRP0
;        x++
    INX
;        { a = x  a ? [ TILE_ROWS ] }<
__label_4
    TXA
    CMP     #$08
    BCC     __label_4
;      } always
    JMP     __label_3
;  
;      unblank
;    } always
	; inlined unblank
__I3unblank
    LDA     #$00
    STA     VBLANK
	; end of inlined unblank
    JMP     __label_2
;  }
;  
; section __vectors
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
; section __entry
__entry
    BIT     __banksel_core
    JMP     main
