// Sub-plan F fixture: known values and known flags, and the two things the
// tracker must never do.
//
// **The value domain tracks lanes.** `lda #0` in an 8-bit accumulator
// establishes the low byte and says nothing about the hidden `B` byte, so an
// `xba` after it — which exchanges the two whatever `M` says — must not leave
// the tracker claiming the accumulator is zero. A domain of `register → value`
// alone is unsound on this CPU (`plans/05-optimizer.md` decision 15).
//
// **The tracker never reads memory.** A load whose source is memory is never
// redundant, because a fixed-address `var` is how K65 spells a hardware
// register: `examples/k65/atari-xl/landscape/main.k65` reads the POKEY
// random-number register in two consecutive statements, and a pass that
// coalesced the second one would break a program that ships here
// (decision 14).

var CELL = $0400
var RND  = $D20A

// The plain case: the same immediate loaded twice, with nothing in between
// that touches the register or the flags it reports on.
func repeated_load @a8 @i8 {
    lda #$07
    CELL = a
    lda #$07
    CELL = a
}

// A store between them changes nothing the load establishes, but a `cmp` does:
// it rewrites N and Z from a comparison, so the second load is no longer a
// complete no-op and stays.
func compare_between @a8 @i8 {
    lda #$07
    a?#$08
    lda #$07
    CELL = a
}

// A redundant `clc`. The flag operation is deleted because it would change
// nothing, not because nothing reads what it changes — which is what keeps
// this pass away from the flags that are live at every exit.
//
// The carry is cleared by a `rep #$01`, which is a mask carrying no width bit:
// no pass but the two mode passes may touch it, and neither has anything to do
// to it, so it stays and the tracker follows it exactly.
func repeated_clear @a8 @i8 {
    rep #$01
    clc
    a+#$01
    CELL = a
}

// And the `clc` that stays, one line apart from it: `adc` writes the carry, so
// the second one is establishing something the first no longer guarantees.
func carry_is_rewritten @a8 @i8 {
    clc
    a+#$01
    clc
    a+#$01
    CELL = a
}

// **Lanes.** `lda #$00` at `@a8` establishes the low byte and says nothing
// about the hidden `B` half; `xba` exchanges the two whatever `M` says, so
// what the accumulator holds afterwards is a byte the tracker never saw. The
// store between them keeps the `xba` alive, and it stays a `sta`: a domain
// that modelled the accumulator as one eight-bit value would call it a store
// of zero and write `stz`. The `lda #$00` after it is not redundant either.
//
// This was `tax` under `@a8 @i16` until `K816-E0171`, which refuses a transfer
// between two axes of known and different widths. The claim is the same one:
// the value domain has to track lanes, because a sixteen-bit move can carry a
// half no eight-bit instruction ever wrote.
func lanes @a8 @i8 {
    lda #$00
    xba
    CELL,x = a
    lda #$00
    CELL,x = a
}

// The same shape with the widths agreeing: `lda #$0000` at `@a16` establishes
// all sixteen bits, `tax` at `@i16` moves all sixteen, and the `ldx #$0000`
// after it *is* redundant.
func lanes_agree @a16 @i16 {
    lda #$0000
    tax
    CELL,x = a
    ldx #$0000
    CELL,x = a
}

// **`XBA` reports on eight bits whatever the accumulator width is.** It moves
// all sixteen, so the *value* it establishes is full-width — but N and Z come
// from the new low byte, regardless of M. `lda #$0001` then `xba` leaves
// A = $0100 with Z **set**, and a 16-bit `lda #$0100` would leave Z clear, so
// the second load is not redundant however much the accumulator agrees.
//
// The tracker keeps the value and forgets the flags, which is why the `lda`
// below stays and the `beq` still branches on what the source says.
func xba_reports_on_the_low_byte @a16 @i16 {
    lda #$0001
    xba
    CELL = a
    lda #$0100
    if == goto .target
    nop
.target:
    nop
}

// **A memory load establishes nothing and clears what was there.** The first
// `lda #$07` is dead — `lda CELL` overwrites A, N, and Z — and the second is
// *not* redundant, because the tracker has no idea what the load put in the
// accumulator. Decision 14's other half: not coalescing the memory read is one
// claim, and not carrying a stale value across it is the other.
func memory_clears_the_tracker @a8 @i8 {
    lda #$07
    a = CELL
    lda #$07
    CELL = a
}

// **A mask that sets N and Z clears the flag provenance.** `sep #$82` writes
// the negative and zero flags directly, so the second `lda #$07` is not a
// no-op however much the accumulator agrees: it puts N and Z back to what the
// value says, and the `beq` below reads them. Without this the branch tests
// the flags the mask left.
func a_mask_can_write_n_and_z @a8 @i8 {
    lda #$07
    sep #$82
    lda #$07
    if == goto .out
    nop
.out:
    nop
}

// **Two reads of a hardware register.** Both survive. K65 has no `volatile`
// and no way to acquire one — a fixed-address `var` is how the language spells
// a memory-mapped register — so a second read of one address is never
// redundant.
func hardware_register @a8 @i8 {
    a = RND
    CELL = a
    a = RND
    CELL = a
}
