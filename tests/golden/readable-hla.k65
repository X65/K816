// `readable-hla.kk` in K65's spellings: the postfix loop, the signed flag
// test, and the stack one register at a time. The two compile to the same
// bytes (`tests/dialect.rs`).

var counter = $80
var flags = $81
const STATUS = $0012

// Counts the set bits of `flags` into `counter`, keeping `a` and `x`.
func count_bits @a8 @i8 {
    a!! x!!
    x = #8
    a = flags
    nocross {
        a >>
        c+?{ counter++ }
        x--
    } !=
    x?? a??
}

// Waits for bit 7 of `flags` to clear, or for the carry to say stop.
func wait_ready @a8 @i8 {
    {
        a&?flags
        n-? break
        c+? break
    } always
    {
        a = flags
        == break
        counter++
    } never
}

// Hands a routine two words on the stack, and drops them after.
func consume @a16 @i16 {
}

func call_with_frame @a16 @i16 {
    pea #STATUS
    pea #$0001
    consume
    x?? x??
}
