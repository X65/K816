// Sub-plan D fixture: block-level mode scoping.
//
// The first function is `doc/register-width-aware-syntax.md`, "Block-level
// mode scoping", verbatim. Its listing in the document is *post*-optimization:
// dead mode elimination and REP/SEP folding are the optimizer's, so K816 emits
// more mode operations here than the document shows. Anyone "fixing" this
// fixture's expected output to match the listing is re-implementing the
// optimizer inside the width model.
//
// What the optimizer does to `scoped` is folding and nothing else: the two
// `rep`s that enter the second block become `rep #$30`, and its two restores
// become `sep #$30`. Every load stays — each one is read by the store or the
// exit below it, and a load before a mode change is live whatever follows,
// because a width transition redefines what a register write covers.
//
// The `sep #$30` is where this file and the document used to disagree. The
// document printed `sep #$20` with the note "i8 needs no SEP -- already
// restored by block exit", and that was wrong: narrowing the index registers
// zeroes the high bytes of X and Y, which is a register write, and every
// register is live where a function returns. Sub-plan F corrected the
// document rather than the compiler.
//
// `nested` and `splitting` lose a block *enter* each, and those are not
// folding: nothing inside either block reads the axis it establishes, and the
// restore below re-establishes it for everything that follows.

func scoped @a8 @i8 {
    lda #1              // 8-bit

    @a16 {
        lda #1          // 16-bit inside the block
    }
    lda #1              // 8-bit — restored

    @a16 @i16 {
        lda #1          // 16-bit
        ldx #1          // 16-bit
    }
    lda #1              // 8-bit — restored
}

// Blocks nest, and each level saves and restores independently.
func nested @a8 @i8 {
    @a16 {
        @i16 {
            lda #1      // 16-bit accumulator, 16-bit index
        }
        ldx #1          // 8-bit index again
    }
    lda #1              // 8-bit accumulator again
}

// A block whose body ends in a `return` restores nothing: control leaves the
// function, so there is nothing to restore to. Silent, and correct.
func returning @a8 {
    @a16 {
        lda #$1234
        return
    }
}

// A branch out of a scoped block used to carry the block's width to its
// target. It now lands on a pad that puts the width back first, hand-written
// native branches included (sub-plan E, decision 9), so the target runs at
// the function's width and a 16-bit immediate there would not fit.
func splitting @a8 {
    @a16 {
        bra .out
    }
.out:
    lda #$12            // 8-bit: the restore on the taken edge got here first
}
