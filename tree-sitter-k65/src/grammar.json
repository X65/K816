{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "k65",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "var_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "func_declaration"
        }
      ]
    },
    "var_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "var"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "_literal"
          }
        }
      ]
    },
    "func_declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "func"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "width",
            "content": {
              "type": "SYMBOL",
              "name": "width_annotation"
            }
          }
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "block"
          }
        }
      ]
    },
    "width_annotation": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "@a8"
          },
          {
            "type": "STRING",
            "value": "@a16"
          },
          {
            "type": "STRING",
            "value": "@i8"
          },
          {
            "type": "STRING",
            "value": "@i16"
          }
        ]
      }
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_statement"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "native_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "hla_load_immediate"
        },
        {
          "type": "SYMBOL",
          "name": "hla_store"
        },
        {
          "type": "SYMBOL",
          "name": "return_statement"
        }
      ]
    },
    "native_instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "mnemonic",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "lda"
                    },
                    {
                      "type": "STRING",
                      "value": "sep"
                    },
                    {
                      "type": "STRING",
                      "value": "rep"
                    }
                  ]
                },
                "named": true,
                "value": "mnemonic"
              }
            },
            {
              "type": "FIELD",
              "name": "operand",
              "content": {
                "type": "SYMBOL",
                "name": "immediate"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "mnemonic",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "STRING",
                  "value": "sta"
                },
                "named": true,
                "value": "mnemonic"
              }
            },
            {
              "type": "FIELD",
              "name": "operand",
              "content": {
                "type": "SYMBOL",
                "name": "address"
              }
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "mnemonic",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "rts"
            },
            "named": true,
            "value": "mnemonic"
          }
        }
      ]
    },
    "hla_load_immediate": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "register",
          "content": {
            "type": "SYMBOL",
            "name": "register"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "immediate"
          }
        }
      ]
    },
    "hla_store": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "source",
          "content": {
            "type": "SYMBOL",
            "name": "register"
          }
        }
      ]
    },
    "return_statement": {
      "type": "STRING",
      "value": "return"
    },
    "register": {
      "type": "STRING",
      "value": "a"
    },
    "immediate": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_literal"
          }
        }
      ]
    },
    "address": {
      "type": "FIELD",
      "name": "symbol",
      "content": {
        "type": "SYMBOL",
        "name": "identifier"
      }
    },
    "_literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "char_literal"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\$[0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "%[01]+"
          },
          {
            "type": "PATTERN",
            "value": "0[bB][01]+"
          },
          {
            "type": "PATTERN",
            "value": "[0-9]+"
          }
        ]
      }
    },
    "char_literal": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^'\\\\\\n]"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "\\"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[abfnrtv0\\\\'\"]"
                      },
                      {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": "x"
                          },
                          {
                            "type": "PATTERN",
                            "value": "[0-9a-fA-F][0-9a-fA-F]"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}